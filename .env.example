# Public browser-safe values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=replace-with-anon-key

# Release switches. Enable each completed slice independently.
NEXT_PUBLIC_ENABLE_SHARED_CATALOGS=false
NEXT_PUBLIC_ENABLE_PRODUCT_SOURCING=false
NEXT_PUBLIC_ENABLE_POST_GO_LIVE_FEATURES=false

# Server-only values — never prefix with NEXT_PUBLIC_
INSFORGE_URL=https://your-appkey.region.insforge.app
INSFORGE_API_KEY=replace-with-server-api-key
CRON_SECRET=replace-with-long-random-secret

OPENROUTER_API_KEY=replace-with-existing-project-gateway-key
ENABLE_PDF_CATALOG_IMPORT=false
PDF_WORKER_TOKEN=replace-with-long-random-worker-token
PDF_WORKER_WAKE_SECRET=replace-with-long-random-wake-secret
PDF_WORKER_URL=
PDF_COMPUTE_USD_PER_HOUR=
PDF_AI_JOB_BUDGET_USD=1
PDF_AI_MONTHLY_BUDGET_USD=50
PDF_COMPUTE_MONTHLY_BUDGET_USD=20

STORAGE_BUCKET_PUBLIC=gisp-public
STORAGE_BUCKET_MEMBER=gisp-member-private
STORAGE_BUCKET_CONFIDENTIAL=gisp-confidential
