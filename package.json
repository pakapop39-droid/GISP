    "test:slice8:branch": "node --env-file=.env.local scripts/slice8-branch-test.mjs",
    "test:slice9:branch": "node --env-file=.env.local scripts/slice9-branch-test.mjs",
    "test:slice10:branch": "node --env-file=.env.local scripts/slice10-branch-test.mjs",
